{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-werewolves",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "APP_ENV": "production",
    "SPIKE_MODEL": "google/gemini-3.1-flash-lite"
  },
  "secrets": {
    "required": ["OPENROUTER_API_KEY", "ACCESS_KEY"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  // One-way: once deployed, `wrangler rollback` cannot cross back past this
  // migration. Never rename or remove GameRoom; evolve its SQLite schema instead.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}
