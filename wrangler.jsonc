{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-werewolves",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "APP_ENV": "production",
    "SPIKE_MODEL": "google/gemini-3.1-flash-lite"
  },
  "secrets": {
    "required": ["OPENROUTER_API_KEY", "ACCESS_KEY"]
  },
  // Archive of terminal games. Migrations in ./migrations are additive only;
  // CI applies them before each deploy.
  "d1_databases": [
    {
      "binding": "ARCHIVE",
      "database_name": "agent-werewolves-archive",
      "database_id": "945653e4-7fb0-4f10-bbe8-00281511661a",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "BATCH_ROOM", "class_name": "BatchRoom" }
    ]
  },
  // One-way: once deployed, `wrangler rollback` cannot cross back past these
  // migrations. Never rename or remove GameRoom or BatchRoom; evolve their
  // SQLite schemas in code instead.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["BatchRoom"] }
  ]
}
