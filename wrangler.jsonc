{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-werewolves",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "APP_ENV": "production"
  }
}
